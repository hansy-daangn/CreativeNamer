{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "파일명 일괄 변경기",
  "mainBinaryName": "CreativeNamer",
  "version": "1.4.0",
  "identifier": "com.daangn.creativenamer",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "파일명 일괄 변경기",
        "width": 460,
        "height": 650,
        "minWidth": 360,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "hansy-daangn",
    "targets": ["nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
